# Production ayarları. Elle doldurmak yerine ./setup-env.sh kullanın.

# Panelin alan adı (DNS A kaydı bu sunucuyu göstermeli)
APP_DOMAIN=app.ornek.com

# Gizli anahtarlar: setup-env.sh rastgele üretir. Kaybetmeyin; ENCRYPTION_KEY
# değişirse kayıtlı token'lar ve uygulama bilgileri çözülemez.
POSTGRES_PASSWORD=
JWT_SECRET=
ENCRYPTION_KEY=

# false: yalnızca ilk kullanıcı (siz) kayıt olabilir
ALLOW_REGISTRATION=false
# Platform uygulamaları panelden girilir (Ayarlar → Platform uygulamaları)
PLATFORM_APPS_FROM_ENV=false
ENABLE_MOCK_PROVIDER=false

# Tanıtım sunucusu için true: giriş ekranında "Demoyu dene"
DEMO_MODE=false
DEMO_TTL_HOURS=24

# Medya: local (sunucu diski, "uploads" volume'u) veya s3 (Cloudflare R2 vb.)
STORAGE_DRIVER=local
# s3 kullanılırsa medyanın herkese açık adresi, ör. https://media.ornek.com
# PUBLIC_MEDIA_BASE_URL=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

INSTAGRAM_GRAPH_VERSION=v23.0
LINKEDIN_API_VERSION=202608
