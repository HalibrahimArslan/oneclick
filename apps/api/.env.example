# --- Temel ---
NODE_ENV=development
PORT=4000
# Panelin adresi (OAuth dönüşünden sonra buraya yönlendirilir)
WEB_URL=http://localhost:5173
# API'nin dışarıdan erişilen adresi (OAuth redirect URI'leri bundan üretilir)
API_PUBLIC_URL=http://localhost:4000

DATABASE_URL=postgresql://oneclick:oneclick@localhost:5432/oneclick
REDIS_URL=redis://localhost:6379

# openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
# Sosyal hesap token'larını şifreleyen anahtar: openssl rand -base64 32
ENCRYPTION_KEY=

# --- Medya depolama ---
# local: dosyalar apps/api/uploads altında tutulur ve API üzerinden sunulur.
# s3: Cloudflare R2 veya herhangi bir S3 uyumlu depolama.
STORAGE_DRIVER=local
# Medyanın herkese açık adresi. Instagram ve TikTok medyayı buradan çeker,
# bu yüzden gerçek yayın testinde internetten erişilebilir olmalı (ör. R2 public URL veya ngrok).
PUBLIC_MEDIA_BASE_URL=http://localhost:4000/media
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Geliştirme kolaylıkları ---
# Gerçek platforma gitmeden yayın akışını denemek için "Test (Mock)" hesabını açar.
ENABLE_MOCK_PROVIDER=true

# --- Instagram (Instagram API with Instagram Login) ---
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_VERSION=v23.0

# --- TikTok (Login Kit + Content Posting API) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- LinkedIn ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Community Management API onayı varsa true yapın (şirket sayfaları)
LINKEDIN_ORGANIZATIONS_ENABLED=false
LINKEDIN_API_VERSION=202608
