# --- Temel ---
NODE_ENV=development
PORT=4000
# Panelin adresi (OAuth dönüşünden sonra buraya yönlendirilir)
WEB_URL=http://localhost:5173
# API'nin dışarıdan erişilen adresi (OAuth redirect URI'leri bundan üretilir)
API_PUBLIC_URL=http://localhost:4000

DATABASE_URL=postgresql://oneclick:oneclick@localhost:5432/oneclick
REDIS_URL=redis://localhost:6379

# openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
# Sosyal hesap token'larını şifreleyen anahtar: openssl rand -base64 32
ENCRYPTION_KEY=

# --- Medya depolama ---
# s3: S3 uyumlu depolama. Yerelde docker compose ile gelen MinIO kullanılır
#     (konsol: http://localhost:9001, oneclick / oneclick-secret). Üretimde Cloudflare R2 vb.
# local: dosyalar apps/api/uploads altında tutulur ve API üzerinden sunulur.
STORAGE_DRIVER=s3
# Medyanın herkese açık adresi. Instagram ve TikTok medyayı buradan çeker; gerçek yayın
# testinde internetten erişilebilir olmalı (ör. R2 public URL ya da MinIO'ya açılmış bir tünel:
# cloudflared tunnel --url http://localhost:9000 → https://xxxx.trycloudflare.com/oneclick).
PUBLIC_MEDIA_BASE_URL=http://localhost:9000/oneclick
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=oneclick
S3_ACCESS_KEY_ID=oneclick
S3_SECRET_ACCESS_KEY=oneclick-secret
# MinIO için true; R2 ve AWS için false bırakılabilir
S3_FORCE_PATH_STYLE=true

# --- Geliştirme kolaylıkları ---
# Gerçek platforma gitmeden yayın akışını denemek için "Test (Mock)" hesabını açar.
ENABLE_MOCK_PROVIDER=true

# --- Kullanıcılar ---
# false: yalnızca ilk kullanıcı (kurulum) kayıt olabilir, sonrası kapalı.
ALLOW_REGISTRATION=true

# --- Platform uygulamaları ---
# Her çalışma alanı kendi Meta / LinkedIn / TikTok uygulamasını panelden girer
# (Ayarlar → Platform uygulamaları). Aşağıdaki anahtarlar yalnızca
# PLATFORM_APPS_FROM_ENV=true iken, panelde bilgi girmemiş çalışma alanları için kullanılır.
# Kaydı herkese açık bir sunucuda false bırakın; yoksa herkes sizin uygulamanız üzerinden bağlanır.
# Mevcut .env bilgilerini panele taşımak için: pnpm apps:import-env <e-posta>
PLATFORM_APPS_FROM_ENV=false

# --- Tanıtım (demo) modu ---
# true: giriş ekranında "Demoyu dene" düğmesi çıkar. Her ziyaretçiye örnek verili,
# geçici bir çalışma alanı açılır; demo hesapları gerçek platformlara yayın yapmaz.
DEMO_MODE=false
# Demo çalışma alanlarının ömrü (saat); süresi dolanları worker siler
DEMO_TTL_HOURS=24
# API bir ters vekil (Caddy, nginx) arkasındaysa true (gerçek istemci IP'si için)
TRUST_PROXY=false

# --- Instagram (Instagram API with Facebook Login) ---
# Meta uygulamasının ana App ID / App Secret değerleri (App settings > Basic).
# Instagram Professional hesabın bir Facebook Sayfasına bağlı olması gerekir.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_VERSION=v23.0

# --- TikTok (Login Kit + Content Posting API) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- LinkedIn ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Community Management API onayı varsa true yapın (şirket sayfaları)
LINKEDIN_ORGANIZATIONS_ENABLED=false
LINKEDIN_API_VERSION=202608
